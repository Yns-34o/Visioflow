const canonicalUrl = "https://visioflow.fr/tarifs";

export default function Tarifs() {
  return (
    <>
      <Head>
        <title>Réservez votre appel de découverte — Visioflow | Agence de création de sites web</title>
        <meta
          name="description"
          content="Réservez votre appel de découverte avec Visioflow pour discuter de votre projet de site web professionnel. Appel gratuit 15-30min ou appel stratégique payant. Tous secteurs confondus."
